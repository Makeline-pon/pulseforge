{
  "name": "@dsh/plugin-pulseforge",
  "version": "1.0.0",
  "description": "PulseForge：DSH Desktop 的原创电子音乐编辑器（16 轨音序器 / 钢琴卷帘 / 纯 Web Audio 合成 / 四路效果链 / WAV 导出）",
  "license": "MIT",
  "author": "PulseForge contributors",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "pwa",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build:release": "node scripts/build-release.mjs",
    "release:pack": "node scripts/build-release.mjs --pack-only",
    "publish:release": "node scripts/publish.mjs",
    "serve": "node scripts/serve.mjs",
    "tauri": "node scripts/tauri.mjs",
    "test": "node tests/smoke.mjs",
    "test:pwa": "node tests/pwa.test.mjs && node tests/pwa-boot.mjs",
    "test:release": "node scripts/build-release.mjs --silent && node tests/release.test.mjs",
    "test:installer": "node tests/installer.test.mjs",
    "test:publish": "node tests/publish.test.mjs",
    "test:all": "node build.mjs && node scripts/build-pwa.mjs && node tests/core.test.mjs && node tests/smoke.mjs && node tests/stress.test.mjs && node tests/dist.mjs && node tests/pwa.test.mjs && node tests/pwa-boot.mjs && npm run test:release && npm run test:installer && npm run test:publish"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "daw",
    "web-audio",
    "sequencer",
    "piano-roll",
    "tauri",
    "pwa"
  ]
}
